        <name>Booking Duration Warning</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading)
        return;

    var bookingDate = new Date(g_form.getValue('booking_date'));
    var returnDate = new Date(newValue);

    var diff = returnDate - bookingDate;

    var days = diff / (1000 * 60 * 60 * 24);

    if (days > 30) {

        g_form.showFieldMsg(
            'return_date',
            'Booking is longer than 30 days.',
            'info'
        );
    }

   
}]]></script>
